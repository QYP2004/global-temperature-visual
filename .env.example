# 大模型 API 配置（仅后端读取，绝不暴露给前端）
# 兼容任何 OpenAI 协议的服务（OpenAI / DeepSeek / Moonshot / 本地 vLLM 等）
# 提示：国内网络直连 api.openai.com 通常超时，建议改用国内可达的端点，例如：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 单次请求超时（秒）与自动重试次数，网络不稳时可调大
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# 可选：覆盖数据库位置
# ROUND_TABLE_DB=./roundtable.db
